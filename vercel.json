{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/special-edition",
      "destination": "/special-edition.html"
    },
    {
      "source": "/medee/(.*)",
      "destination": "/medee/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/gift-preview/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/gifts",
      "destination": "/special-edition",
      "permanent": true
    }
  ]
}
